<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>
  <!-- Lectures "short-circuit" impossibles : Impala et le DataNode ne sont pas
       dans le même conteneur. Lecture classique via le DataNode. -->
  <property>
    <name>dfs.client.read.shortcircuit</name>
    <value>false</value>
  </property>
</configuration>
