    {
      "title": "Spark (PySpark)",
      "text": "%spark.pyspark\n# Spark 4.0.4 : même table, lue via le metastore Hive partagé\nfrom pyspark.sql import functions as F\n\ndf = spark.table(\"sales_db.transactions\")\ndf.printSchema()\n(df.groupBy(\"city\")\n   .agg(F.count(\"*\").alias(\"nb_ventes\"), F.round(F.sum(\"amount\"), 2).alias(\"chiffre_affaires\"))\n   .orderBy(F.desc(\"chiffre_affaires\"))\n   .show())\nprint(\"Version de Spark :\", spark.version)",
      "user": "anonymous",
      "dateUpdated": "2026-10-02 09:00:23.000",
      "progress": 0,
      "config": {
