    {
      "title": "HBase (happybase)",
      "text": "%python\n# HBase 2.6.7 via son serveur Thrift (bibliothèque happybase)\nimport happybase\n\ntry:\n    conn = happybase.Connection(\"hbase-thrift\", 9090, timeout=20000)\n    print(\"Tables HBase :\", [t.decode() for t in conn.tables()])\n    table = conn.table(\"clients_hbase\")\n    for key, data in table.scan(limit=5):\n        print(key.decode(), {k.decode(): v.decode() for k, v in sorted(data.items())})\n    conn.close()\nexcept Exception as e:\n    print(\"HBase indisponible (profil hbase démarré ? service hbase-init terminé ?) :\", repr(e))",
      "user": "anonymous",
      "dateUpdated": "2026-10-02 09:00:26.000",
      "progress": 0,
